# Copier ce fichier en `.env` SUR L'EC2 uniquement (jamais dans Git).
# Les valeurs ci-dessous sont des exemples à remplacer.

# Registre ECR (ou GHCR si ECR indisponible)
ECR=123456789012.dkr.ecr.us-east-1.amazonaws.com

# Mot de passe des keystores PKI (phase 5)
PKI_PASS=changeit

# Base RDS (phase 8)
DB_URL_CUSTOMERS=jdbc:mysql://petclinic-db.example.us-east-1.rds.amazonaws.com:3306/petclinic_customers?sslMode=REQUIRED
DB_URL_VETS=jdbc:mysql://petclinic-db.example.us-east-1.rds.amazonaws.com:3306/petclinic_vets?sslMode=REQUIRED
DB_URL_VISITS=jdbc:mysql://petclinic-db.example.us-east-1.rds.amazonaws.com:3306/petclinic_visits?sslMode=REQUIRED
DB_USERNAME=petclinic_app
DB_PASSWORD=changeit

# Keycloak (admin de l'IdP, différent de l'utilisateur demo/demo)
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=changeit
